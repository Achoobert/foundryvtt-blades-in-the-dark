{"_id":"122214b0191c34de","name":"The Church","type":"faction","img":"icons/svg/city.svg","system":{"description":"","type":"Institutions","tier":"4","goal_1":"","goal_1_clock_max":0,"goal_2":"","goal_2_clock_max":0,"turf":"","assets":"","quirks":"","notables":"","allies":"","enemies":"","situation":"","goal_clock":0,"hold":{"value":1,"max":2,"max_default":2,"name_default":"BITD.Hold","name":"BITD.Hold"},"status":{"value":[0],"max":7,"max_default":7,"name_default":"BITD.Status","name":"BITD.Status"},"notes":"'The Church of the Ecstasy of the Flesh', or the 'C of E'. They honor the life of the body and deem the transcendent, spiritual, or otherworldly to be heretical. Ruthless enforcers of conformity."},"effects":[],"folder":null,"sort":0,"permission":{"default":0},"flags":{}}
{"_id":"b4bc35ce7a00c876","name":"Ironhook Prison","type":"faction","img":"icons/svg/city.svg","system":{"description":"","type":"Institutions","tier":"4","goal_1":"","goal_1_clock_max":0,"goal_2":"","goal_2_clock_max":0,"turf":"","assets":"","quirks":"","notables":"","allies":"","enemies":"","situation":"","goal_clock":0,"hold":{"value":1,"max":2,"max_default":2,"name_default":"BITD.Hold","name":"BITD.Hold"},"status":{"value":[0],"max":7,"max_default":7,"name_default":"BITD.Status","name":"BITD.Status"},"notes":"A rusting relic of centuries past, where many scoundrels spend the bulk of their lives. In danger of being replaced by the Lusk Reform Technique."},"effects":[],"folder":null,"sort":0,"permission":{"default":0},"flags":{}}
{"_id":"90fc6f4a0ec1e908","name":"Blackthorn Park","type":"faction","img":"icons/svg/city.svg","system":{"description":"","type":"Institutions","tier":"3","goal_1":"","goal_1_clock_max":0,"goal_2":"","goal_2_clock_max":0,"turf":"","assets":"","quirks":"","notables":"","allies":"","enemies":"","situation":"","goal_clock":0,"hold":{"value":2,"max":2,"max_default":2,"name_default":"BITD.Hold","name":"BITD.Hold"},"status":{"value":[0],"max":7,"max_default":7,"name_default":"BITD.Status","name":"BITD.Status"},"notes":"The foreign intelligence service of the United Skov Covenant. As Doskvol is the closest city to the border between Skovlan and Akoros, and contains a large population of Skovlanders, it’s a flashpoint in the covert war between Blackthorn Park and the Palace."},"effects":[],"folder":null,"sort":0,"permission":{"default":0},"flags":{}}
{"_id":"a894b04452636573","name":"Bluecoats","type":"faction","img":"icons/svg/city.svg","system":{"description":"","type":"Institutions","tier":"3","goal_1":"","goal_1_clock_max":0,"goal_2":"","goal_2_clock_max":0,"turf":"","assets":"","quirks":"","notables":"","allies":"","enemies":"","situation":"","goal_clock":0,"hold":{"value":2,"max":2,"max_default":2,"name_default":"BITD.Hold","name":"BITD.Hold"},"status":{"value":[0],"max":7,"max_default":7,"name_default":"BITD.Status","name":"BITD.Status"},"notes":"The City Watch of Duskwall, tasked with upholding the law. Decades of PR have rebranded them as your friendly local constables, but they are still just as corrupt, violent, and cruel as ever. "},"effects":[],"folder":null,"sort":0,"permission":{"default":0},"flags":{}}
{"_id":"15af4e7b0ae30743","name":"Inspectors","type":"faction","img":"icons/svg/city.svg","system":{"description":"","type":"Institutions","tier":"3","goal_1":"","goal_1_clock_max":0,"goal_2":"","goal_2_clock_max":0,"turf":"","assets":"","quirks":"","notables":"","allies":"","enemies":"","situation":"","goal_clock":0,"hold":{"value":2,"max":2,"max_default":2,"name_default":"BITD.Hold","name":"BITD.Hold"},"status":{"value":[0],"max":7,"max_default":7,"name_default":"BITD.Status","name":"BITD.Status"},"notes":"The criminal investigators of the City Watch. They have a reputation for ethics and integrity (no one likes them). They present evidence for prosecutions to the city magistrates."},"effects":[],"folder":null,"sort":0,"permission":{"default":0},"flags":{}}
{"_id":"0ef4b6b12ccf9356","name":"Lusk Reform Clinic","type":"faction","img":"icons/svg/city.svg","system":{"description":"","type":"Institutions","tier":"3","goal_1":"","goal_1_clock_max":0,"goal_2":"","goal_2_clock_max":0,"turf":"","assets":"","quirks":"","notables":"","allies":"","enemies":"","situation":"","goal_clock":0,"hold":{"value":2,"max":2,"max_default":2,"name_default":"BITD.Hold","name":"BITD.Hold"},"status":{"value":[0],"max":7,"max_default":7,"name_default":"BITD.Status","name":"BITD.Status"},"notes":"A small but well-funded facility near Ironhook Prison. Pioneers of the Lusk Reform Technique; they can turn the most violent criminal into one of the reformed (vacant-eyed hollows) and also produce a brand new hull to serve the city. "},"effects":[],"folder":null,"sort":0,"permission":{"default":0},"flags":{}}
